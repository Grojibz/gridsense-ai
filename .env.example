# Copy to .env and fill in. The .env file is git-ignored.

# --- General ---------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- LLM providers ---------------------------------------------------------
# Chat and embeddings are chosen separately: Anthropic serves no embeddings API, so
# "Claude generates, Ollama embeds" is the default, not a workaround.
# anthropic | azure | ollama
CHAT_PROVIDER=anthropic
# voyage | azure | ollama
EMBEDDING_PROVIDER=ollama

# Deprecated: sets BOTH of the above at once, as pre-Claude releases did. Left here so an
# existing .env keeps working; an explicit CHAT_PROVIDER/EMBEDDING_PROVIDER always wins.
# LLM_PROVIDER=ollama

# Voyage (required when EMBEDDING_PROVIDER=voyage). Anthropic's recommended embedding
# partner; voyage-4-lite ships 200M free tokens, which this corpus will never exhaust.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite

# Anthropic (required when CHAT_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Exact model ID, no date suffix.
ANTHROPIC_MODEL=claude-opus-5
# Thinking depth and token spend: low | medium | high | xhigh | max.
ANTHROPIC_EFFORT=high
# Caps thinking AND answer text together — thinking is on by default on Opus 5, so a
# ceiling sized around the answer alone truncates the response mid-sentence.
ANTHROPIC_MAX_TOKENS=16000

# Azure OpenAI (required when either provider is azure)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Ollama (used when either provider is ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Ollama defaults num_ctx to 2048 whatever the model supports; a RAG prompt with
# several chunks overflows that and is silently truncated.
OLLAMA_NUM_CTX=8192
# GPU layers. Leave unset to let Ollama decide. Set to 0 to force CPU-only — the
# escape hatch when the GPU computes incorrectly, which Ollama reports as
# fluent garbage rather than as an error, and which also corrupts embeddings.
# OLLAMA_NUM_GPU=0

# --- DocRAG guardrails -----------------------------------------------------
# Upstream (applied to the query before any token is spent)
DOCRAG_MAX_INPUT_TOKENS=512
DOCRAG_INJECTION_THRESHOLD=0.5
DOCRAG_INTENT_ROUTER_ENABLED=true
# spaCy NER as an extra PII detector. Needs `pip install spacy` +
# `python -m spacy download en_core_web_sm`; the regex scrubber runs either way.
DOCRAG_PII_NER_ENABLED=false

# Downstream (applied to the model's output)
DOCRAG_OUTPUT_RETRIES=1
DOCRAG_MIN_GROUNDEDNESS=0.6

# Uncertainty disclosure — calibrate against your embedding provider, the
# relevance scale is not comparable across models. Run
# `python eval/calibrate_relevance.py` after changing EMBEDDING_PROVIDER.
DOCRAG_UNCERTAIN_CONFIDENCE=0.6
DOCRAG_UNCERTAIN_RELEVANCE=0.60

# --- Datastores ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://gridsense:gridsense@localhost:5432/gridsense
MLFLOW_TRACKING_URI=http://localhost:5000

# docker-compose Postgres credentials (keep in sync with DATABASE_URL)
POSTGRES_USER=gridsense
POSTGRES_PASSWORD=gridsense
POSTGRES_DB=gridsense

# --- Observability (Langfuse) ----------------------------------------------
# These default keys are auto-provisioned by the LANGFUSE_INIT_* vars in
# docker-compose. Leave blank to disable tracing (the app no-ops gracefully).
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-gridsense-dev
LANGFUSE_SECRET_KEY=sk-lf-gridsense-dev
LANGFUSE_NEXTAUTH_SECRET=dev-secret-change-me
LANGFUSE_SALT=dev-salt-change-me
LANGFUSE_INIT_USER_EMAIL=dev@gridsense.local
LANGFUSE_INIT_USER_PASSWORD=gridsense-dev
